{
  "name": "@danielmarbach/pi-tgrep",
  "version": "0.2.2",
  "description": "tgrep-backed code search for pi: auto-indexes the repo and routes all grep traffic through the trigram index",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "tgrep",
    "search"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielmarbach/pi-tgrep.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "analyze": "node scripts/analyze-pi-sessions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/harness.mjs test/bash-policy-fallback.test.mjs test/bash-provenance.test.mjs test/grep-details.test.mjs test/server-lifecycle.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2"
  }
}
